<%= link_to rune_art, class: "card bg-base-100 overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition border-t-4",
      style: "border-top-color: #{rune_art.color}" do %>
  <figure class="aspect-[5/7] bg-base-300">
    <%= rune_image_tag rune_art, class: "w-full h-full object-cover" %>
  </figure>
  <div class="p-2.5 space-y-1">
    <div class="font-semibold text-sm truncate"><%= rune_art.name %></div>
    <div class="text-xs opacity-70 truncate"><%= rune_art.set_name %><%= " · ##{rune_art.collector_number}" if rune_art.collector_number.present? %></div>
    <div class="flex flex-wrap gap-1">
      <%= domain_badge rune_art.domain, size: "badge-xs" %>
      <span class="badge badge-xs badge-outline"><%= rune_art.variant %></span>
    </div>
  </div>
<% end %>

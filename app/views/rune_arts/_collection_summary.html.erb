<div id="collection-summary" class="card bg-base-100 border border-base-content/10 p-4 mb-5">
  <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
    <div class="flex-1 min-w-56">
      <div class="flex justify-between text-sm mb-1.5">
        <span class="font-semibold">Dex progress <span class="font-normal opacity-50">(<%= RuneArt::COLLECTION_GOAL %> of each)</span></span>
        <span class="tabular-nums opacity-70"><%= stats[:owned] %> / <%= stats[:goal] %></span>
      </div>
      <progress class="progress progress-primary w-full" value="<%= stats[:owned] %>" max="<%= [ stats[:goal], 1 ].max %>"></progress>
    </div>
    <div>
      <div class="text-[11px] uppercase tracking-wider opacity-50">Discovered</div>
      <div class="text-xl font-bold tabular-nums"><%= stats[:discovered] %><span class="text-sm font-normal opacity-50"> / <%= stats[:total] %></span></div>
    </div>
    <div>
      <div class="text-[11px] uppercase tracking-wider opacity-50">Complete</div>
      <div class="text-xl font-bold tabular-nums"><%= stats[:complete] %><span class="text-sm font-normal opacity-50"> / <%= stats[:total] %></span></div>
    </div>
    <div>
      <div class="text-[11px] uppercase tracking-wider opacity-50">Cost to finish</div>
      <div class="text-xl font-bold text-accent tabular-nums"><%= number_to_currency(stats[:cost]) %></div>
      <% if stats[:unpriced].positive? %>
        <div class="text-[11px] opacity-50">+ <%= stats[:unpriced] %> unpriced</div>
      <% end %>
    </div>
  </div>
</div>

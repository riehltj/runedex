<% content_for :title, "#{@rune_art.name} · Rune Art Tracker" %>
<%= link_to "← All arts", rune_arts_path, class: "btn btn-ghost btn-sm mb-4" %>

<div class="grid md:grid-cols-[minmax(0,420px)_1fr] gap-6">
  <figure class="rounded-2xl overflow-hidden shadow-xl aspect-[5/7] bg-base-300 border-4" style="border-color: <%= @rune_art.color %>">
    <%= rune_image_tag @rune_art, class: "w-full h-full object-cover" %>
  </figure>

  <div class="space-y-4">
    <div>
      <h1 class="text-3xl font-bold"><%= @rune_art.name %></h1>
      <div class="flex flex-wrap gap-2 mt-2">
        <%= domain_badge @rune_art.domain %>
        <span class="badge badge-outline"><%= @rune_art.variant %></span>
      </div>
    </div>

    <div class="card bg-base-100">
      <div class="card-body p-4">
        <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
          <% { "Set" => @rune_art.set_name,
               "Collector #" => @rune_art.collector_number,
               "Artist" => @rune_art.artist,
               "How to get it" => @rune_art.source,
               "Released" => @rune_art.released_on&.strftime("%b %-d, %Y") }.compact_blank.each do |label, value| %>
            <dt class="opacity-60"><%= label %></dt>
            <dd><%= label == "Set" ? link_to(value, rune_arts_path(set: value), class: "link") : value %></dd>
          <% end %>
        </dl>
        <% if @rune_art.notes.present? %>
          <div class="divider my-1"></div>
          <p class="text-sm whitespace-pre-line"><%= @rune_art.notes %></p>
        <% end %>
      </div>
    </div>

    <div class="flex gap-2">
      <%= link_to "Edit", edit_rune_art_path(@rune_art), class: "btn btn-sm" %>
      <%= button_to "Delete", @rune_art, method: :delete, class: "btn btn-sm btn-error btn-outline",
            form: { data: { turbo_confirm: "Delete this art?" } } %>
    </div>
  </div>
</div>

<%# Owned-copies counter toward a playset. Replaced in place by RuneArtsController#collect. %>
<div id="<%= dom_id(art, :collect) %>" class="mt-1.5" data-owned="<%= art.owned_count %>">
  <div class="flex items-center gap-1.5">
    <%= button_to "−", collect_rune_art_path(art, delta: -1), method: :patch,
          disabled: art.owned_count.zero?, form: { class: "contents" },
          class: "btn btn-sm btn-square text-lg font-bold bg-base-300 border-base-content/20 hover:border-base-content/50 disabled:opacity-30",
          aria: { label: "Remove a copy" } %>

    <div class="flex-1 text-center tabular-nums leading-none">
      <span class="text-base font-bold" style="<%= "color: #{art.color}" if art.complete? %>">
        <%= "✓ " if art.complete? %><%= art.owned_count %>
      </span><span class="text-xs opacity-50">/<%= RuneArt::COLLECTION_GOAL %></span>
    </div>

    <%= button_to "+", collect_rune_art_path(art, delta: 1), method: :patch,
          form: { class: "contents" },
          class: "btn btn-sm btn-square text-lg font-bold border-0 text-black hover:brightness-110",
          style: "background: #{art.color}; box-shadow: 0 0 10px #{art.color}66",
          aria: { label: "Add a copy" } %>
  </div>

  <div class="flex gap-0.5 mt-1.5" title="<%= art.owned_count %> of <%= RuneArt::COLLECTION_GOAL %> owned">
    <% RuneArt::COLLECTION_GOAL.times do |i| %>
      <span class="h-1.5 flex-1 rounded-full <%= 'bg-base-content/15' unless i < art.owned_count %>"
            style="<%= "background: #{art.color}; box-shadow: 0 0 4px #{art.color}" if i < art.owned_count %>"></span>
    <% end %>
  </div>

  <% unless art.complete? %>
    <div class="text-[11px] text-center opacity-50 tabular-nums mt-1 truncate">
      <%= art.cost_to_complete ? "#{number_to_currency(art.cost_to_complete)} to go" : "need #{art.needed}" %>
    </div>
  <% end %>
</div>

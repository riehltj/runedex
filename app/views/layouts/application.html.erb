<!DOCTYPE html>
<html data-theme="night">
  <head>
    <title><%= content_for(:title) || "Rune Art Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="application-name" content="Rune Art Tracker">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%# Tailwind + DaisyUI via CDN, no build step %>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css">

    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-200 min-h-screen">
    <div class="navbar bg-base-100 shadow-sm px-2 sm:px-4 sticky top-0 z-10">
      <div class="flex-1">
        <%= link_to root_path, class: "btn btn-ghost text-base sm:text-lg px-2 gap-2" do %>
          <span class="flex -space-x-1">
            <% RuneArt::DOMAINS.each_value do |d| %>
              <span class="size-2.5 rounded-full ring-1 ring-base-100" style="background: <%= d[:color] %>"></span>
            <% end %>
          </span>
          Rune Art Tracker
        <% end %>
      </div>
      <%= link_to "+ Add Art", new_rune_art_path, class: "btn btn-primary btn-sm" %>
    </div>

    <main class="container mx-auto mt-4 sm:mt-6 px-4 max-w-6xl pb-16">
      <% if notice %><div role="alert" class="alert alert-success mb-4"><span><%= notice %></span></div><% end %>
      <% if alert %><div role="alert" class="alert alert-error mb-4"><span><%= alert %></span></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>

<!DOCTYPE html>
<html data-theme="dex">
  <head>
    <title><%= content_for(:title) || "RuneDex" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="application-name" content="RuneDex">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%# Tailwind + DaisyUI via CDN, no build step %>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css">
    <style>
      /* RuneDex: crimson handheld shell, charcoal screens, mint readouts. */
      [data-theme="dex"] {
        color-scheme: dark;
        --color-base-100: #23262d;
        --color-base-200: #15171b;
        --color-base-300: #2e323b;
        --color-base-content: #eef0f3;
        --color-primary: #e23b4e;
        --color-primary-content: #ffffff;
        --color-accent: #7ee8c4;
        --color-accent-content: #08261c;
        --color-neutral: #2e323b;
        --color-neutral-content: #eef0f3;
        --dex-shell: #c41e3a;
        --dex-shell-dark: #8e1528;
      }
      body {
        font-family: "Chakra Petch", ui-sans-serif, system-ui, sans-serif;
        background:
          radial-gradient(1200px 500px at 50% -200px, rgb(226 59 78 / 0.12), transparent),
          var(--color-base-200);
      }
      .tabular-nums, .text-accent { font-variant-numeric: tabular-nums; }
    </style>

    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-200 min-h-screen">
    <div class="navbar px-2 sm:px-4 sticky top-0 z-10 gap-2 text-white shadow-lg border-b-4"
         style="background: var(--dex-shell); border-color: var(--dex-shell-dark)">
      <div class="flex-1">
        <%= link_to root_path, class: "btn btn-ghost hover:bg-white/10 border-0 text-white text-base sm:text-xl px-2 gap-2" do %>
          <span class="flex -space-x-1">
            <% RuneArt::DOMAINS.each_value do |d| %>
              <span class="size-2.5 rounded-full ring-2 ring-[var(--dex-shell)]" style="background: <%= d[:color] %>"></span>
            <% end %>
          </span>
          <span class="font-bold tracking-wide uppercase">Rune<span class="opacity-75">Dex</span></span>
          <span class="hidden md:inline text-xs font-medium text-white/70 ml-1 normal-case">Every rune. Six of each.</span>
        <% end %>
      </div>
      <%= link_to "+ Add Art", new_rune_art_path, class: "btn btn-sm border-0 bg-white font-semibold hover:bg-white/90", style: "color: var(--dex-shell)" %>
    </div>

    <main class="container mx-auto mt-4 sm:mt-6 px-4 max-w-7xl pb-16">
      <% if notice %><div role="alert" class="alert alert-success mb-4"><span><%= notice %></span></div><% end %>
      <% if alert %><div role="alert" class="alert alert-error mb-4"><span><%= alert %></span></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
